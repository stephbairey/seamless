# Seamless (SL) Secrets — Example Template
# Copy this file to secrets.env and fill in real values.
# NEVER commit secrets.env — it is gitignored.

# ClickUp
CLICKUP_API_TOKEN=

# Gmail (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Calendar (separate auth per calendar)
GCAL_LINGUAINKMEDIA_TOKEN=
GCAL_MJBAIREY_TOKEN=
GCAL_STEPHBAIREY_TOKEN=

# Google Drive
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# YNAB
YNAB_API_TOKEN=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe
STRIPE_API_KEY=

# Venmo (business account, if available)
VENMO_ACCESS_TOKEN=

# Social Media (as needed during content distribution setup)
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
YOUTUBE_API_KEY=
TIKTOK_ACCESS_TOKEN=

# WordPress (linguaink.com, bairey.com, sulimamalzin.net)
WP_LINGUAINK_APP_PASSWORD=
WP_BAIREY_APP_PASSWORD=
WP_SULIMA_APP_PASSWORD=

# WooCommerce (bairey.com)
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
